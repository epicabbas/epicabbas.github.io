{% assign item = include.item %}
{% assign has_media = false %}
{% if item.images and item.images.size > 0 %}
  {% assign has_media = true %}
  {% assign image_count = item.images.size %}
{% elsif item.img %}
  {% assign has_media = true %}
  {% assign image_count = 1 %}
{% endif %}

<article
  class="gallery-stop{% if has_media %} gallery-stop--media{% endif %}"
  data-category="{{ item.category | slugify }}"
>
  <div class="gallery-stop__when">
    {% if item.date %}
      <span class="gallery-stop__month">{{ item.date | date: '%b' }}</span>
      <span class="gallery-stop__year">{{ item.date | date: '%Y' }}</span>
    {% endif %}
  </div>

  <div class="gallery-stop__card">
    {% if item.images and item.images.size > 0 %}
      <div class="gallery-stop__media{% if image_count > 1 %} award-card__media--carousel{% endif %}" {% if image_count > 1 %}data-award-carousel{% endif %}>
        <div class="award-card__track"{% if image_count > 1 %} tabindex="0" role="region" aria-label="{{ item.title }} photos"{% endif %}>
          {% for image in item.images %}
            <div
              class="award-card__shot"
              {% if image.object_position %}
                style="--award-focal: {{ image.object_position }}"
              {% endif %}
            >
              {%
                include figure.liquid
                loading="lazy"
                path=image.path
                sizes="(min-width: 768px) 400px, 95vw"
                alt=image.alt
                title=item.title
                class="award-card__photo gallery-stop__photo"
                zoomable=true
              %}
            </div>
          {% endfor %}
        </div>
        {% if image_count > 1 %}
          <button type="button" class="award-card__nav award-card__nav--prev" aria-label="Previous photo">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <button type="button" class="award-card__nav award-card__nav--next" aria-label="Next photo">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
          <div class="award-card__dots" role="tablist" aria-label="Photo slides">
            {% for image in item.images %}
              <button
                type="button"
                class="award-card__dot{% if forloop.first %} is-active{% endif %}"
                data-award-dot
                aria-label="Photo {{ forloop.index }} of {{ image_count }}"
              ></button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% elsif item.img %}
      <div
        class="gallery-stop__media"
        {% if item.object_position %}
          style="--award-focal: {{ item.object_position }}"
        {% endif %}
      >
        {%
          include figure.liquid
          loading="lazy"
          path=item.img
          sizes="(min-width: 768px) 400px, 95vw"
          alt=item.img_alt
          title=item.title
          class="award-card__photo gallery-stop__photo"
          zoomable=true
        %}
      </div>
    {% endif %}

    <div class="gallery-stop__body">
      {% if item.category %}
        <span class="gallery-stop__category">{{ item.category }}</span>
      {% endif %}

      {% if item.title %}
        <h3 class="gallery-stop__title">
          {% if item.url %}
            <a href="{{ item.url }}">{{ item.title }}</a>
          {% else %}
            {{ item.title }}
          {% endif %}
        </h3>
      {% endif %}

      {% if item.role %}
        <p class="gallery-stop__role">{{ item.role }}</p>
      {% endif %}

      <p class="gallery-stop__facts">
        {% if item.date_display %}
          <span>{{ item.date_display }}</span>
        {% elsif item.date %}
          <span>{{ item.date | date: '%B %Y' }}</span>
        {% endif %}
        {% if item.location %}
          <span>{{ item.location }}</span>
        {% endif %}
      </p>

      {% if item.content %}
        <div class="gallery-stop__story">{{ item.content }}</div>
      {% endif %}

      {% if item.project_url or item.award_url or item.links %}
        <div class="gallery-stop__links">
          {% if item.project_url %}
            <a class="award-link" href="{{ item.project_url | relative_url }}">About Project</a>
          {% endif %}
          {% if item.award_url %}
            <a class="award-link" href="{{ item.award_url | relative_url }}">Award</a>
          {% endif %}
          {% if item.links %}
            {% for link in item.links %}
              <a class="award-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
                {% if link.icon %}<i class="{{ link.icon }}"></i>{% endif %}
                {{ link.label }}
              </a>
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</article>
