---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        {% assign banner_first = site.first_name | split: ' ' | first %}
        <span class="font-weight-bold">{{ banner_first }}</span>
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
    <div class="typing-container">
      <span id="typed-text"></span><span class="typing-cursor">|</span>
    </div>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">favourite publication </a>
      </h2>
      {% include selected_papers.liquid %} 
    {% endif %}
     
    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const phrases = [
      "Software Engineer @ Flusso Faucets, USA",
      "Building AI-powered e-commerce experiences",
      "Shipping products that scale to thousands of users",
      "MS in CS - Cleveland State University, USA",
      "HackPSU Hackathon North America Winner 2024"
    ];
    const el = document.getElementById("typed-text");
    if (!el) return;
    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;

    function tick() {
      const current = phrases[phraseIdx];
      if (!deleting) {
        el.textContent = current.substring(0, charIdx + 1);
        charIdx++;
        if (charIdx === current.length) {
          setTimeout(function () { deleting = true; tick(); }, 2000);
          return;
        }
        setTimeout(tick, 80);
      } else {
        el.textContent = current.substring(0, charIdx - 1);
        charIdx--;
        if (charIdx === 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(tick, 400);
          return;
        }
        setTimeout(tick, 40);
      }
    }
    tick();
  });

  // Ambient background — floating symbols + orbital rings
  (function () {
    if (document.getElementById("bg-symbols")) return;

    // Clean line-art rocket (inherits the blue theme colour, not the emoji)
    var ROCKET_SVG =
      '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" ' +
      'stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      '<path d="M4 13a8 8 0 0 1 7 7a6 6 0 0 0 3 -5a9 9 0 0 0 6 -8a3 3 0 0 0 -3 -3a9 9 0 0 0 -8 6a6 6 0 0 0 -5 3"/>' +
      '<path d="M7 14a6 6 0 0 0 -3 6a6 6 0 0 0 6 -3"/>' +
      '<path d="M15 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>' +
      '</svg>';

    // Branded symbol set — AI/LLM, rockets/space, design, + code glyphs
    var SYMBOLS = [
      // AI / LLM
      { ch: "🧠", op: 0.14 }, { ch: "🤖", op: 0.14 }, { ch: "💬", op: 0.13 },
      { ch: "🔮", op: 0.13 }, { ch: "✨", op: 0.16 }, { ch: "🪄", op: 0.13 },
      { ch: "⚙️", op: 0.13 },
      // Rockets / space
      { svg: ROCKET_SVG, op: 0.5 }, { ch: "🛰️", op: 0.12 }, { ch: "🛸", op: 0.13 },
      { ch: "🌙", op: 0.15 }, { ch: "☄️", op: 0.12 }, { ch: "🔭", op: 0.13 },
      // Design
      { ch: "🎨", op: 0.13 }, { ch: "✏️", op: 0.13 }, { ch: "📐", op: 0.12 },
      { ch: "🖌️", op: 0.12 },
      // Code / engineer glyphs
      { ch: "{ }", op: 0.16 }, { ch: "</>", op: 0.16 },
      // Elegant Unicode accents
      { ch: "✦", op: 0.22 }, { ch: "◇", op: 0.18 }, { ch: "⬡", op: 0.16 },
      { ch: "∞", op: 0.2 }, { ch: "⊙", op: 0.17 }
    ];

    // [left%, top%, anim-suffix, size-px] — spread around the edges, clear of content
    var LAYOUT = [
      [3, 6, "a", 28], [14, 3, "b", 35], [30, 8, "c", 22], [58, 4, "d", 30],
      [72, 7, "a", 26], [88, 2, "b", 34], [95, 10, "c", 28],
      [1, 28, "d", 32], [2, 52, "a", 26], [4, 74, "b", 30], [6, 90, "c", 24],
      [92, 30, "d", 28], [94, 55, "a", 34], [96, 78, "b", 26], [91, 92, "c", 30],
      [18, 94, "a", 26], [38, 97, "b", 22], [55, 95, "d", 28], [75, 92, "a", 32],
      [85, 96, "c", 24],
      [20, 42, "b", 18], [50, 65, "c", 16], [78, 40, "d", 18]
    ];

    var container = document.createElement("div");
    container.id = "bg-symbols";
    document.body.prepend(container);

    LAYOUT.forEach(function (item, i) {
      var x = item[0], y = item[1], animSuffix = item[2], size = item[3];
      var sym = SYMBOLS[i % SYMBOLS.length];
      var duration = 24 + (i % 7) * 6;   // 24–60s
      var delay = -(i * 4.1);            // stagger so they don't move in sync

      var el = document.createElement("span");
      el.className = "bg-sym";
      if (sym.svg) {
        el.innerHTML = sym.svg;
        el.style.color = "var(--global-theme-color)";
      } else {
        el.textContent = sym.ch;
      }
      el.setAttribute("aria-hidden", "true");
      el.style.cssText = [
        "left:" + x + "%",
        "top:" + y + "%",
        "font-size:" + size + "px",
        "--sym-op:" + sym.op,
        "animation:sym-drift-" + animSuffix + " " + duration + "s " + delay + "s ease-in-out infinite alternate"
      ].join(";");

      container.appendChild(el);
    });

    // Orbital rings crossing the viewport like satellite orbits
    // [left-vw, top-vh, width-vw, height-vw, rotation-deg]
    var RINGS = [
      [-8, 28, 130, 48, -22],
      [110, 62, 118, 44, 20],
      [48, 108, 150, 52, 6]
    ];
    RINGS.forEach(function (r) {
      var el = document.createElement("div");
      el.className = "orbit-ring";
      el.style.cssText = [
        "left:" + r[0] + "vw",
        "top:" + r[1] + "vh",
        "width:" + r[2] + "vw",
        "height:" + r[3] + "vw",
        "--ring-rot:" + r[4] + "deg"
      ].join(";");
      container.appendChild(el);
    });
  })();
</script>
