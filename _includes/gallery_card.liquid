{% assign item = include.item %}
{% assign slide_count = 0 %}
{% if item.images and item.images.size > 0 %}
  {% assign slide_count = item.images.size %}
{% elsif item.img %}
  {% assign slide_count = 1 %}
{% endif %}

<article
  class="gallery-tile{% if slide_count > 1 %} gallery-tile--slideshow{% endif %}"
  data-category="{{ item.category | slugify }}"
  {% if slide_count > 1 %}data-gallery-slideshow{% endif %}
>
  {% if item.images and item.images.size > 0 %}
    <div class="gallery-tile__slides"{% if slide_count > 1 %} role="group" aria-label="{{ item.title }} photos"{% endif %}>
      {% for image in item.images %}
        {% assign photo_caption = image.caption %}
        {% if photo_caption == nil or photo_caption == "" %}
          {% if item.caption %}
            {% assign photo_caption = item.caption %}
          {% else %}
            {% assign photo_caption = item.title %}
          {% endif %}
        {% endif %}
        {% assign photo_alt = image.alt %}
        {% if photo_alt == nil or photo_alt == "" %}
          {% assign photo_alt = photo_caption %}
        {% endif %}
        <div class="gallery-tile__slide{% if forloop.first %} is-active{% endif %}">
          {%
            include figure.liquid
            loading="lazy"
            path=image.path
            sizes="(min-width: 576px) 50vw, 95vw"
            alt=photo_alt
            title=photo_caption
            class="gallery-tile__photo"
            zoomable=true
          %}
          <div class="gallery-tile__meta">
            {% if item.category %}
              <span class="gallery-tile__category">{{ item.category }}</span>
            {% endif %}
            {% if photo_caption %}
              <span class="gallery-tile__title">{{ photo_caption }}</span>
            {% endif %}
            {% if item.date_display or item.date or item.location %}
              <span class="gallery-tile__facts">
                {% if item.date_display %}
                  {{ item.date_display }}
                {% elsif item.date %}
                  {{ item.date | date: '%B %Y' }}
                {% endif %}
                {% if item.location %}
                  {% if item.date_display or item.date %} · {% endif %}{{ item.location }}
                {% endif %}
              </span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if slide_count > 1 %}
      <div class="gallery-tile__dots" role="tablist" aria-label="{{ item.title }} photos">
        {% for image in item.images %}
          <button
            type="button"
            class="gallery-tile__dot{% if forloop.first %} is-active{% endif %}"
            data-gallery-dot
            aria-label="Photo {{ forloop.index }} of {{ slide_count }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  {% elsif item.img %}
    {% assign photo_caption = item.caption %}
    {% if photo_caption == nil or photo_caption == "" %}
      {% assign photo_caption = item.title %}
    {% endif %}
    {% assign photo_alt = item.img_alt %}
    {% if photo_alt == nil or photo_alt == "" %}
      {% assign photo_alt = photo_caption %}
    {% endif %}
    {%
      include figure.liquid
      loading="lazy"
      path=item.img
      sizes="(min-width: 576px) 50vw, 95vw"
      alt=photo_alt
      title=photo_caption
      class="gallery-tile__photo"
      zoomable=true
    %}
    <div class="gallery-tile__meta">
      {% if item.category %}
        <span class="gallery-tile__category">{{ item.category }}</span>
      {% endif %}
      {% if photo_caption %}
        <span class="gallery-tile__title">{{ photo_caption }}</span>
      {% endif %}
      {% if item.date_display or item.date or item.location %}
        <span class="gallery-tile__facts">
          {% if item.date_display %}
            {{ item.date_display }}
          {% elsif item.date %}
            {{ item.date | date: '%B %Y' }}
          {% endif %}
          {% if item.location %}
            {% if item.date_display or item.date %} · {% endif %}{{ item.location }}
          {% endif %}
        </span>
      {% endif %}
    </div>
  {% endif %}
</article>
